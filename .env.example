# Janova GovTech Portal Environment Configuration Example

# Optional: Google Gemini API Key for live AI Assistant responses
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Resend API Key for Email OTP Login Verification
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0

# Database Connection (Defaults to local SQLite)
DATABASE_URL=sqlite:///./janova.db
